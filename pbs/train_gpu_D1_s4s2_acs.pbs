#!/bin/bash
#PBS -N D1s4s2acs
#PBS -q miggpu24h
#PBS -l nodes=1:ppn=8
#PBS -e logs/gpu_D1_s4s2_acs.err
#PBS -o logs/gpu_D1_s4s2_acs.out

cd $PBS_O_WORKDIR
echo "Job starting:" `date`
mkdir -p logs

module load python/3.8.11-intel-2021.3.0
source nijenhuis/bin/activate

unset CUDA_VISIBLE_DEVICES
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export PYTHONUNBUFFERED=1

# Round-1 derivative-program recipe (see config header). S^4 x S^2 ACS.
# Monitor with: tail -f logs/gpu_D1_s4s2_acs.log
python train.py --config configs/ACS/config_gpu_D1_s4s2_acs.yaml 2>&1 | tee logs/gpu_D1_s4s2_acs.log

echo "Job completed:" `date`
