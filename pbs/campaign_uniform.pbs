#!/bin/bash
#PBS -N nijuni
#PBS -q par16
#PBS -l nodes=1:ppn=16
#PBS -l walltime=240:00:00
#PBS -j oe

# UNIFORM CHART-FREE PINN CAMPAIGN (CENAPAD LOVELACE, CPU only).
# All 9 cases (S2, S4, S6, S1xS1, S2xS2, S3xS1, S3xS3, S4xS2, S5xS1), both
# tasks (ACS, CS), 2 seeds: 36 units from jobs_uniform.txt, run 14 at a time,
# each single-threaded. Parallelizable cases use the global-frame Nijenhuis
# (no charts); the others the ambient-projector Nijenhuis (embedding-space
# trick). Every unit is restartable and time-guarded; results are scored
# under the paper's original chart protocol (result.json per unit).
#
# SCRATCH DISCIPLINE: $PBS_O_WORKDIR is treated as read-only at runtime.
# Results/logs go to /work/tomas/<jobname>_<jobid>; final results are
# rsync'ed back to $PBS_O_WORKDIR/results_from_HPC/<jobid> at the end (plus a
# safety sync every 6h). The scratch dir is NOT deleted.
#
# Unit line format (jobs_uniform.txt):
#   CASE TASK SEED STEPS HIDDEN STAGES [rar]
#
# Submit:  qsub pbs/campaign_uniform.pbs
#          qsub -v JOBS_FILE=jobs_uniform.txt pbs/campaign_uniform.pbs
# Shorter walltime:  qsub -l walltime=120:00:00 -v WALL_MIN=2000 pbs/campaign_uniform.pbs
# Summary afterwards:  python extra/campaign_summary.py results_from_HPC/<jobid>

CODE_ROOT="$PBS_O_WORKDIR"
cd "$CODE_ROOT"
module load python/3.8.11-intel-2021.3.0
source nijenhuis/bin/activate
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1

JOB_ID=${PBS_JOBID%%.*}
SCRATCH="/work/tomas/${PBS_JOBNAME:-nijuni}_${JOB_ID}"
OUT_ROOT="$SCRATCH/results"
LOG_ROOT="$SCRATCH/logs"
mkdir -p "$OUT_ROOT" "$LOG_ROOT" "$SCRATCH/tmp"
export TMPDIR="$SCRATCH/tmp"

JOBS_FILE=${JOBS_FILE:-jobs_uniform.txt}
WALL_MIN=${WALL_MIN:-4200}          # per-unit budget (70h); 36 units / 14 slots = 3 waves < 240h
NPAR=${NPAR:-14}
export CODE_ROOT OUT_ROOT LOG_ROOT WALL_MIN

FINAL_DIR="$CODE_ROOT/results_from_HPC/$JOB_ID"
sync_back () {
  mkdir -p "$FINAL_DIR"
  rsync -a --exclude 'state.pt' "$OUT_ROOT/" "$FINAL_DIR/" 2>> "$LOG_ROOT/rsync_err.txt"
}
trap sync_back EXIT
( while sleep 21600; do sync_back; done ) &
SYNC_PID=$!

echo "== nijuni: $(wc -l < "$JOBS_FILE") units from $JOBS_FILE"
echo "==   scratch: $SCRATCH   (results -> $FINAL_DIR at end)"
echo "==   per-unit wall: ${WALL_MIN} min, parallel units: $NPAR =="
date

xargs -P "$NPAR" -L 1 -a "$JOBS_FILE" bash -c '
  set -- $0 "$@"
  case=$1; task=$2; seed=$3; steps=$4; hidden=$5; stages=$6; extra=$7
  RARARG=""; if [ "$extra" = "rar" ]; then RARARG="--rar"; fi
  dir="$OUT_ROOT/${case}_${task}_s${seed}"
  mkdir -p "$dir"
  python "$CODE_ROOT/extra/campaign_unit.py" \
      --case "$case" --task "$task" --seed "$seed" --steps "$steps" \
      --hidden "$hidden" --stages "$stages" $RARARG \
      --wall-minutes "$WALL_MIN" --out "$dir" \
      >> "$LOG_ROOT/${case}_${task}_s${seed}.txt" 2>&1
'
date
kill "$SYNC_PID" 2>/dev/null
sync_back
echo "== done; results copied to $FINAL_DIR (scratch kept at $SCRATCH) =="
