#!/bin/bash
#PBS -N nijamb
#PBS -q par16
#PBS -l nodes=1:ppn=16
#PBS -l walltime=240:00:00
#PBS -j oe

# ONE COMMON APPROACH FOR ALL 9 CASES (S2, S4, S6, S1xS1, S2xS2, S3xS1, S3xS3,
# S4xS2, S5xS1): the AMBIENT-PROJECTOR formulation everywhere (each case is a
# product of unit spheres in R^N; fields J = P M(p) P; Nijenhuis from ambient
# brackets; no charts, no frames). Unsupervised end to end:
#   phase A  ACS from scratch: harmonic-ladder polynomial stage -> MLP
#            refinement -> ADVERSARIAL certification -> exact polar ACS
#   phase B  CS from the unit's OWN certified ACS (--base-from), Nijenhuis-only
#            conjugation search. S4 (no ACS exists) fails certification in A
#            and its CS unit refuses in B: the built-in negative control.
#
# Scratch discipline: results in /work/tomas/<jobname>_<jobid>/results,
# rsync'ed to $PBS_O_WORKDIR/results_from_HPC/<jobid>/ every 6h and at exit
# (scratch kept). Code root treated as read-only at runtime.
#
# Unit lines:  jobs_ambient_acs.txt  CASE SEED STEPS HIDDEN
#              jobs_ambient_cs.txt   CASE SEED STEPS HIDDEN STAGES
# Submit:  qsub pbs/campaign_ambient.pbs
#          qsub -l walltime=120:00:00 -v WALL_MIN_CS=2000 pbs/campaign_ambient.pbs
# Summary: python extra/campaign_summary.py results_from_HPC/<jobid>

CODE_ROOT="$PBS_O_WORKDIR"
cd "$CODE_ROOT"
module load python/3.8.11-intel-2021.3.0
source nijenhuis/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

JOB_ID=${PBS_JOBID%%.*}
SCRATCH="/work/tomas/${PBS_JOBNAME:-nijamb}_${JOB_ID}"
OUT_ROOT="$SCRATCH/results"; LOG_ROOT="$SCRATCH/logs"
mkdir -p "$OUT_ROOT" "$LOG_ROOT" "$SCRATCH/tmp"; export TMPDIR="$SCRATCH/tmp"
WALL_MIN_ACS=${WALL_MIN_ACS:-600}      # per ACS unit (typically minutes)
WALL_MIN_CS=${WALL_MIN_CS:-4000}       # per CS unit (2 waves of 14 fit in 240 h)
NPAR=${NPAR:-14}
export CODE_ROOT OUT_ROOT LOG_ROOT WALL_MIN_ACS WALL_MIN_CS

FINAL_DIR="$CODE_ROOT/results_from_HPC/$JOB_ID"
sync_back () { mkdir -p "$FINAL_DIR"; rsync -a --exclude 'state.pt' "$OUT_ROOT/" "$FINAL_DIR/" 2>> "$LOG_ROOT/rsync_err.txt"; }
trap sync_back EXIT
( while sleep 21600; do sync_back; done ) & SYNC_PID=$!

echo "== nijamb phase A: ACS from scratch, ambient formulation ($(wc -l < jobs_ambient_acs.txt) units) =="; date
xargs -P "$NPAR" -L 1 -a jobs_ambient_acs.txt bash -c '
  set -- $0 "$@"; case=$1; seed=$2; steps=$3; hidden=$4
  dir="$OUT_ROOT/${case}_acs_s${seed}"; mkdir -p "$dir"
  python "$CODE_ROOT/extra/campaign_unit.py" --case "$case" --task acs --seed "$seed" \
      --formulation ambient --steps "$steps" --hidden "$hidden" --poly-steps 3000 \
      --wall-minutes "$WALL_MIN_ACS" --out "$dir" >> "$LOG_ROOT/${case}_acs_s${seed}.txt" 2>&1
'
sync_back
echo "== nijamb phase B: CS from own certified ACS ($(wc -l < jobs_ambient_cs.txt) units) =="; date
xargs -P "$NPAR" -L 1 -a jobs_ambient_cs.txt bash -c '
  set -- $0 "$@"; case=$1; seed=$2; steps=$3; hidden=$4; stages=${5:-2}
  dir="$OUT_ROOT/${case}_cs_s${seed}"; mkdir -p "$dir"
  python "$CODE_ROOT/extra/campaign_unit.py" --case "$case" --task cs --seed "$seed" \
      --formulation ambient --steps "$steps" --hidden "$hidden" --stages "$stages" \
      --base-from "$OUT_ROOT/${case}_acs_s${seed}" --wall-minutes "$WALL_MIN_CS" \
      --out "$dir" >> "$LOG_ROOT/${case}_cs_s${seed}.txt" 2>&1
'
date; kill "$SYNC_PID" 2>/dev/null; sync_back
echo "== done; results in $FINAL_DIR (scratch kept at $SCRATCH) =="
