#!/bin/bash
#PBS -N gpu_B2_s5s1_cs
#PBS -q miggpu24h
#PBS -l nodes=1:ppn=8
#PBS -e logs/gpu_B2_s5s1_cs.err
#PBS -o logs/gpu_B2_s5s1_cs.out

cd $PBS_O_WORKDIR
echo "Job starting:" `date`
mkdir -p logs

module load python/3.8.11-intel-2021.3.0
source nijenhuis/bin/activate

# MIG can appear as a plain GPU; unset in case the driver hides it.
unset CUDA_VISIBLE_DEVICES

# GPU handles the tensor parallelism; CPU threading just needs to feed data.
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export PYTHONUNBUFFERED=1   # real-time log

python train.py --config configs/CS/config_gpu_B2_s5s1_cs_baseline.yaml 2>&1 | tee logs/gpu_B2_s5s1_cs.log

echo "Job completed:" `date`
